# Local development only. Replace placeholder passwords before first startup.
POSTGRES_DB=call_summary
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-local-db-admin
DB_APP_PASSWORD=replace-local-db-app
DB_MIGRATION_PASSWORD=replace-local-db-migrator
DATABASE_URL=postgresql+psycopg://call_summary_app:replace-local-db-app@db:5432/call_summary
MIGRATION_DATABASE_URL=postgresql+psycopg://call_summary_migrator:replace-local-db-migrator@db:5432/call_summary
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
MINIO_ROOT_USER=local-admin
MINIO_ROOT_PASSWORD=replace-local-minio-admin
AUDIO_STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=call-audio
S3_ACCESS_KEY_ID=call-summary-app
S3_SECRET_ACCESS_KEY=replace-local-s3-app
S3_ADDRESSING_STYLE=path
AUDIO_TEMP_DIR=/tmp/call-summary
LOCAL_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
MAX_AUDIO_BYTES=104857600
WORKER_CONCURRENCY=1
WORKER_MAX_ATTEMPTS=3
WORKER_LEASE_SECONDS=120
TRANSCRIBER_PROVIDER=deepgram
DIARIZER_PROVIDER=deepgram
DEEPGRAM_TOKEN=
LLM_PROVIDER=unconfigured
LLM_API_KEY=
API_PORT=8010
DB_PORT=5432
S3_PORT=9000
MINIO_CONSOLE_PORT=9001
